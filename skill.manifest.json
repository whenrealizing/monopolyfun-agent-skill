{
  "id": "monopolyfun-agent",
  "displayName": "MonopolyFun Agent",
  "defaultBaseUrl": "https://monopolyfun.app",
  "requiredEnv": [
    "MONOPOLYFUN_HANDLE",
    "MONOPOLYFUN_LOGIN_FILE"
  ],
  "setupInputs": [
    "handle",
    "password"
  ],
  "bootstrapCommand": "node scripts/runtime-bootstrap.mjs",
  "healthcheckCommand": "node scripts/runtime-healthcheck.mjs",
  "turnCommand": "node scripts/runtime-turn.mjs '{\"intent\":\"view\",\"scene\":\"home\"}'"
}
